---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import GithubIcon from '../../components/GithubIcon.astro';
import SglDemo from '../../islands/SglDemo.svelte';
import SglStage from '../../islands/SglStage.svelte';
import SglPipeline from '../../islands/SglPipeline.svelte';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <article class="container project">
    <div class="project__inner">
      <SectionHeading label={`${project.data.year} / ${project.data.tags.join(' / ')}`} title={project.data.title}>
        {
          project.data.repoUrl && (
            <a class="repo-link fade" style="--d:0.6s" href={project.data.repoUrl} aria-label={`${project.data.title} on GitHub`} target="_blank" rel="noopener noreferrer">
              <GithubIcon size={28} />
            </a>
          )
        }
        {
          project.data.repoUrl && (
            <a slot="subtitle" class="repo-subtitle fade" style="--d:0.6s" href={project.data.repoUrl} target="_blank" rel="noopener noreferrer">
              {project.data.title} on GitHub →
            </a>
          )
        }
      </SectionHeading>
      {project.data.demo === 'sgl' && <div class="rise" style="--d:0.7s"><SglDemo client:visible notes={project.data.demoNotes} /></div>}
      <div class="rise" style="--d:0.7s"><Content /></div>
    </div>
    {
      project.data.story.length > 0 && (
        <div class="story">
          {project.data.demo === 'sgl' && (
            <div class="story__bg" aria-hidden="true">
              <SglPipeline client:visible />
            </div>
          )}
          {project.data.story.map((step, i) => (
            <section class:list={['step', 'reveal', { 'step--flip': i % 2 === 1, 'step--text-only': !step.visual }]}>
              <div class="step__text">
                <span class="meta">{String(i + 1).padStart(2, '0')} / {project.data.story.length}</span>
                <h3 class="display step__title">
                  {step.title}
                  {step.link?.href.includes('github.com') && (
                    <a class="repo-link" href={step.link.href} aria-label={step.link.label} target="_blank" rel="noopener noreferrer">
                      <GithubIcon size={28} />
                    </a>
                  )}
                </h3>
                <p>{step.body}</p>
                {step.link && <a href={step.link.href}>{step.link.label} →</a>}
              </div>
              {step.visual && (
                <div class="step__visual">
                  <SglStage client:visible kind={step.visual} label={step.visualLabel ?? step.title} />
                </div>
              )}
            </section>
          ))}
        </div>
      )
    }
  </article>
</BaseLayout>

<style>
  .project {
    padding-top: var(--space-5);
  }
  .project__inner {
    max-width: 48rem;
  }
  .repo-link {
    display: inline-flex;
    color: var(--color-fg-muted);
    transition: color 0.2s;
  }
  .step__title .repo-link {
    margin-left: var(--space-1);
    vertical-align: middle;
  }
  .repo-subtitle {
    align-self: flex-start;
  }
  .repo-link:hover,
  .repo-link:focus-visible {
    color: var(--color-fg);
  }
  .story {
    position: relative;
    margin-top: var(--space-5);
  }
  /* The pipeline animation stays put behind the steps while the page scrolls. */
  .story__bg {
    position: sticky;
    top: 0;
    height: 100dvh;
    margin-bottom: -100dvh;
    pointer-events: none;
  }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 22rem);
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-4);
  }
  .step--flip {
    grid-template-columns: minmax(14rem, 22rem) minmax(0, 1fr);
  }
  .step--flip .step__text {
    order: 2;
  }
  .step--text-only {
    grid-template-columns: minmax(0, 48rem);
  }
  .step__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: 40rem;
  }
  .step__title {
    font-size: clamp(2rem, 4vw, 3rem);
  }
  .step__text p {
    margin: 0;
    font-size: var(--text-md);
  }
  .step__text a {
    align-self: flex-start;
  }
  @media (max-width: 52rem) {
    .step,
    .step--flip {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }
    .step--flip .step__text {
      order: 0;
    }
  }
</style>
