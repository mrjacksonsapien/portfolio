---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BitGrid from '../islands/BitGrid.svelte';
import { site } from '../data/site';
---

<BaseLayout title="About me">
  <div class="about-page">
    <BitGrid client:idle />
    <section class="container about">
      <div class="about__inner">
        <SectionHeading label="About" title="About me" />
        {site.about.map((paragraph, i) => <p class="rise" style={`--d:${0.7 + i * 0.25}s`}>{paragraph}</p>)}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-page {
    position: relative;
    min-height: 70dvh;
    /* Let the grid grow past the page into the footer's top margin, without moving the footer. */
    --bitgrid-extend: var(--space-6);
  }
  .about {
    padding-top: var(--space-5);
  }
  .about__inner {
    max-width: 48rem;
  }
  p {
    margin: 0 0 var(--space-3);
    font-size: var(--text-md);
  }
</style>
