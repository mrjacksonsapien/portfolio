---
import { getCollection } from 'astro:content';
import { site } from '../data/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const isActive = (href: string) => currentPath === href || currentPath === `${href}/`;
const inProjects = currentPath.startsWith('/projects');
---

<header class="navbar">
  <div class="container navbar__inner">
    <a class="navbar__brand" href="/">{site.name}</a>
    <nav aria-label="Main">
      <ul class="navbar__list">
        <li><a href="/" aria-current={isActive('/') ? 'page' : undefined}>Home</a></li>
        <li class="dropdown" data-dropdown>
          <button type="button" class="dropdown__toggle" aria-haspopup="true" aria-expanded="false" aria-current={inProjects ? 'page' : undefined}>
            Projects <span aria-hidden="true">▾</span>
          </button>
          <ul class="dropdown__menu">
            {
              projects.map((p) => (
                <li>
                  <a href={`/projects/${p.id}`} aria-current={isActive(`/projects/${p.id}`) ? 'page' : undefined}>
                    {p.data.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </li>
        <li><a href="/about" aria-current={isActive('/about') ? 'page' : undefined}>About me</a></li>
        <li class="navbar__icons">
          <a href={site.links.github} aria-label="GitHub" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
          </a>
          <a href={site.links.linkedin} aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
          </a>
          <div class="dropdown" data-dropdown>
            <button type="button" class="dropdown__toggle" aria-label="Resume (PDF)" title="Resume (PDF)" aria-haspopup="true" aria-expanded="false">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8M8 17h8M8 9h2"/></svg>
            </button>
            <ul class="dropdown__menu">
              <li><a href={site.links.resume.en} lang="en" target="_blank" rel="noopener noreferrer">Resume (English)</a></li>
              <li><a href={site.links.resume.fr} lang="fr" target="_blank" rel="noopener noreferrer">CV (Français)</a></li>
            </ul>
          </div>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // Touch support: tapping a toggle opens its menu (iOS Safari does not focus buttons on tap).
  // Hover and focus-within in the CSS keep working for mouse and keyboard.
  const dropdowns = document.querySelectorAll<HTMLElement>('[data-dropdown]');

  function setOpen(dropdown: HTMLElement, open: boolean) {
    dropdown.toggleAttribute('data-open', open);
    dropdown.querySelector('.dropdown__toggle')?.setAttribute('aria-expanded', String(open));
  }

  dropdowns.forEach((dropdown) => {
    dropdown.querySelector('.dropdown__toggle')?.addEventListener('click', () => {
      const open = !dropdown.hasAttribute('data-open');
      dropdowns.forEach((d) => setOpen(d, d === dropdown && open));
    });
  });
  document.addEventListener('click', (event) => {
    dropdowns.forEach((d) => {
      if (!d.contains(event.target as Node)) setOpen(d, false);
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') dropdowns.forEach((d) => setOpen(d, false));
  });
</script>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: linear-gradient(var(--color-bg), transparent);
  }
  .navbar__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: var(--space-2);
  }
  .navbar__brand {
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .navbar__list {
    display: flex;
    gap: var(--space-3);
    align-items: center;
  }
  nav a,
  .dropdown__toggle {
    color: var(--color-fg-muted);
    text-decoration: none;
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
  }
  nav a:hover,
  .dropdown__toggle:hover,
  [aria-current='page'] {
    color: var(--color-fg);
  }
  .navbar__icons {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }
  .navbar__icons a,
  .navbar__icons .dropdown__toggle {
    display: inline-flex;
  }
  .navbar__icons .dropdown__menu {
    min-width: 10rem;
    white-space: nowrap;
  }
  .dropdown {
    position: relative;
  }
  .dropdown__menu {
    position: absolute;
    top: 100%;
    right: 0;
    min-width: 12rem;
    padding: var(--space-1) var(--space-2);
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    display: none;
  }
  .dropdown__menu li {
    padding-block: 0.25rem;
  }
  .dropdown[data-open] .dropdown__menu,
  .dropdown:hover .dropdown__menu,
  .dropdown:focus-within .dropdown__menu {
    display: block;
  }
</style>
