---
// A slightly tilted screenshot. It links to the large version; the Lightbox island turns the click into a viewer
// (without JavaScript the link just opens the image). `src` has no size suffix or extension, see content.config.ts.
interface Props {
  src: string;
  alt: string;
  caption?: string;
  tilt?: number;
  orientation?: 'landscape' | 'portrait';
}

const { src, alt, caption, tilt = 0, orientation = 'landscape' } = Astro.props;
const portrait = orientation === 'portrait';
---

<a class:list={['photo', { 'photo--portrait': portrait }]} href={`${src}-1920.webp`} data-lightbox data-caption={caption} style={`--tilt:${tilt}deg`}>
  <img src={`${src}-960.webp`} {alt} width={portrait ? 720 : 960} height={portrait ? 960 : 540} loading="lazy" decoding="async" />
</a>

<style>
  .photo {
    display: block;
    rotate: var(--tilt);
    border: 1px solid var(--color-line);
    box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.6);
    transition:
      rotate 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
      scale 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
      border-color 0.2s;
    cursor: zoom-in;
  }
  .photo:hover,
  .photo:focus-visible {
    rotate: 0deg;
    scale: 1.025;
    border-color: var(--color-fg-muted);
  }
  /* Tall pictures would fill the screen at the column width, so they are narrower and centered. */
  .photo--portrait {
    width: min(100%, 18rem);
    margin-inline: auto;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
