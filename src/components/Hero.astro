---
import Starfield from '../islands/Starfield.svelte';
---

<section class="hero">
  <Starfield client:visible />
  <div class="container hero__inner">
    <h1 class="display">
      <span class="accent">Your</span><br />Title.
    </h1>
    <p class="hero__intro meta">
      Short presentation of yourself goes here. Replace this placeholder text.
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 80dvh;
    display: flex;
    align-items: flex-end;
    padding-bottom: var(--space-5);
  }
  .hero__inner {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .hero__intro {
    max-width: 24rem;
  }
</style>
