---
import Starfield from '../islands/Starfield.svelte';
import SilkWaves from '../islands/SilkWaves.svelte';
import { site } from '../data/site';
---

<section class="hero">
  <Starfield client:idle />
  <SilkWaves client:idle />
  <div class="container hero__inner">
    <h1 class="display">
      <span class="accent type" style={`--n:${site.headline.lead.length}`}>{site.headline.lead}</span><br /><span class="wipe" style="--d:0.9s">{site.headline.main}</span>
    </h1>
    <p class="hero__intro meta rise" style="--d:1.6s">{site.intro}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 80dvh;
    display: flex;
    align-items: flex-end;
    padding-bottom: var(--space-5);
  }
  .hero__inner {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .accent {
    font-size: 0.4em;
  }
  .hero__intro {
    max-width: 24rem;
  }
</style>
