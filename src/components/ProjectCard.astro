---
import GithubIcon from './GithubIcon.astro';
import RobloxIcon from './RobloxIcon.astro';
import ProjectBackground from './ProjectBackground.astro';

interface Props {
  id: string;
  title: string;
  summary: string;
  year: number;
  tags: string[];
  repoUrl?: string;
  robloxUrl?: string;
  index?: number;
  layout?: string;
  background?: string;
  demo?: string;
}

const { id, title, summary, year, tags, repoUrl, robloxUrl, index = 0, layout, background, demo } = Astro.props;

// The same canvas as the project page, if it has one.
const backdrop = demo === 'sgl' ? 'sgl' : layout === 'showcase' ? (background === 'circuit' ? 'circuit' : 'bubbles') : undefined;
---

<article class="card rise" style={`--d:${0.8 + index * 0.12}s`}>
  {backdrop && <div class="card__bg" aria-hidden="true"><ProjectBackground kind={backdrop} contained /></div>}
  <span class="meta">{year}</span>
  <h3 class="card__title"><a class="card__link" href={`/projects/${id}`}>{title}</a></h3>
  <p class="card__summary">{summary}</p>
  <span class="meta">{tags.join(' / ')}</span>
  {
    repoUrl && (
      <a class="card__repo fade" style={`--d:${1 + index * 0.12}s`} href={repoUrl} aria-label={`${title} on GitHub`} target="_blank" rel="noopener noreferrer">
        <GithubIcon />
      </a>
    )
  }
  {
    robloxUrl && (
      <a class="card__repo fade" style={`--d:${1 + index * 0.12}s`} href={robloxUrl} aria-label={`${title} on Roblox`} target="_blank" rel="noopener noreferrer">
        <RobloxIcon />
      </a>
    )
  }
</article>

<style>
  .card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3);
    border: 1px solid var(--color-line);
    transition: border-color 0.2s;
  }
  .card:hover,
  .card:focus-within {
    border-color: var(--color-fg);
  }
  .card__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    /* Barely visible until the card is hovered or focused. */
    opacity: 0.35;
    transition: opacity 0.3s;
  }
  .card:hover .card__bg,
  .card:focus-within .card__bg {
    opacity: 1;
  }
  .card__link {
    color: inherit;
    text-decoration: none;
  }
  /* The title link covers the whole card; the GitHub icon sits above it. */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card__repo {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    z-index: 1;
    display: inline-flex;
    color: var(--color-fg-muted);
    transition: color 0.2s;
  }
  .card__repo:hover,
  .card__repo:focus-visible {
    color: var(--color-fg);
  }
  .card__title {
    font-family: var(--font-display);
    font-size: 2.5rem;
    text-transform: uppercase;
    line-height: 1;
  }
  .card__summary {
    margin: 0;
    color: var(--color-fg-muted);
  }
</style>
